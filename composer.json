{
    "name": "dpdconnect/prestashop-shipping",
    "description": "DPD Prestashop shipping extension",
    "license": "GPL-3.0-or-later",
    "type": "prestashop-module",
    "prefer-stable": true,
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "dpdconnect/php-sdk": "^2.1",
        "iio/libmergepdf": "^4.0"
    },
    "require-dev": {
        "prestashop/php-dev-tools": "^5.0",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "DpdConnect\\": "src/",
            "DpdConnect\\Form\\": "src/Form/",
            "DpdConnect\\classes\\": ["classes"],
            "DpdConnect\\Controller\\Admin\\": "controllers/admin"
        }
    },
    "config": {
        "preferred-install": "dist",
        "prepend-autoloader": false,
        "platform": {
            "php": "7.4.0"
        }
    }
}
